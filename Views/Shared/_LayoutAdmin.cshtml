@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    // 1. LẤY THÔNG TIN TỪ SESSION
    var currentUsername = HttpContextAccessor.HttpContext.Session.GetString("UserName");
    var currentFullName = HttpContextAccessor.HttpContext.Session.GetString("FullName") ?? "Quản trị viên";
    var currentRole = HttpContextAccessor.HttpContext.Session.GetString("Role") ?? "Staff";

    // 2. BẢO MẬT: NẾU CHƯA ĐĂNG NHẬP -> CHUYỂN VỀ LOGIN
    if (string.IsNullOrEmpty(currentUsername))
    {
        Context.Response.Redirect("/Account/Login");
        return;
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sunrise Hotel Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --sidebar-bg: #1a252f;
            --active: #d4af37;
            --text-muted: #8e9aaf;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            background: #f8f9fa;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            overflow-x: hidden;
        }

        /* SIDEBAR */
        .sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            background: var(--sidebar-bg);
            color: white;
            transition: var(--transition);
            z-index: 1050;
        }

        .sidebar-header {
            background: rgba(0,0,0,0.2);
            padding: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .nav-link {
            color: #b0b8c1;
            padding: 12px 25px;
            transition: var(--transition);
            border-left: 4px solid transparent;
            display: flex;
            align-items: center;
            font-size: 0.95rem;
        }

            .nav-link i {
                width: 30px;
                font-size: 1.1rem;
            }

            .nav-link:hover {
                color: var(--active);
                background: rgba(212, 175, 55, 0.08);
                border-left-color: var(--active);
            }

            .nav-link.active {
                color: white;
                background: rgba(255,255,255,0.08);
                border-left-color: var(--active);
                font-weight: 600;
            }

        /* MAIN CONTENT */
        .main-content {
            margin-left: 260px;
            padding: 0;
            min-height: 100vh;
            transition: var(--transition);
        }

        .top-navbar {
            background: white;
            padding: 12px 30px;
            border-bottom: 1px solid #e0e0e0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        /* NOTIFICATION */
        .notification-dropdown {
            width: 320px;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            border-radius: 8px;
            padding: 0;
        }

        .notification-item {
            border-bottom: 1px solid #f0f0f0;
            padding: 12px 15px;
            transition: background 0.2s;
            cursor: pointer;
        }

            .notification-item:hover {
                background: #f8f9fa;
            }

        .section-label {
            font-size: 0.65rem;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.3);
            padding: 25px 25px 10px;
            display: block;
            text-transform: uppercase;
        }

        .badge-role {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 4px 10px;
            border-radius: 50px;
        }
    </style>
</head>
<body>

    <div class="sidebar shadow">
        <div class="sidebar-header text-center">
            <h5 class="m-0 fw-bold text-warning" style="letter-spacing: 1px;">
                <i class="fas fa-hotel me-2"></i>SUNRISE ADMIN
            </h5>
            <small class="text-white-50" style="font-size: 0.6rem;">THE SUNRISE GRAND PALACE</small>
        </div>

        <div class="p-3 d-flex align-items-center border-bottom border-secondary">
            <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center me-3 shadow" style="width:45px;height:45px">
                <span class="fw-bold fs-5">@currentFullName.Substring(0, 1).ToUpper()</span>
            </div>
            <div style="overflow: hidden;">
                <div class="fw-bold small text-white text-truncate">@currentFullName</div>
                <span class="badge bg-success badge-role">@currentRole</span>
            </div>
        </div>

        <nav class="nav flex-column mt-2">
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")"
               href="/Dashboard/Index">
                <i class="fas fa-tachometer-alt"></i> Tổng quan
            </a>

            <span class="section-label">Nghiệp vụ lễ tân</span>

            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" && ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")"
               href="/Bookings/Dashboard">
                <i class="fas fa-th"></i> Sơ đồ phòng
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")"
               href="/Bookings">
                <i class="fas fa-calendar-check"></i> Danh sách Đơn
            </a>

            <span class="section-label">Kho & Thực phẩm</span>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "active" : "")" href="/Products">
                <i class="fas fa-boxes"></i> Tồn kho
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Imports" ? "active" : "")" href="/Imports">
                <i class="fas fa-file-import"></i> Nhập hàng
            </a>

            @if (currentRole == "Admin")
            {
                <span class="section-label">Quản trị hệ thống</span>
                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "RevenueReport" ? "active" : "")" href="/Dashboard/RevenueReport">
                    <i class="fas fa-chart-pie"></i> Báo cáo Doanh thu
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "EmployeeReport" ? "active" : "")" href="/Dashboard/EmployeeReport">
                    <i class="fas fa-user-shield"></i> Quản lý Nhân sự
                </a>
            }

            <div class="mt-4 border-top border-secondary pt-2">
                <a class="nav-link text-danger" href="/Account/Logout">
                    <i class="fas fa-sign-out-alt"></i> Đăng xuất
                </a>
            </div>
        </nav>
    </div>

    <div class="main-content">

        <div class="top-navbar d-flex justify-content-between align-items-center shadow-sm">
            <div class="text-muted small">
                <i class="far fa-clock me-2"></i> @DateTime.Now.ToString("dddd, dd/MM/yyyy")
            </div>

            <div class="d-flex align-items-center">
                <a href="/" target="_blank" class="btn btn-sm btn-outline-dark fw-bold rounded-pill px-3 me-3 shadow-sm">
                    <i class="fas fa-globe me-1"></i> Xem Website
                </a>

                <div class="dropdown">
                    <button class="btn btn-sm btn-light position-relative shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-bell text-secondary fs-6 pt-1"></i>
                        <span id="notif-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none; font-size: 0.65rem;">
                            0
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end notification-dropdown">
                        <li class="p-3 border-bottom bg-light fw-bold small text-uppercase text-primary">Thông báo mới</li>

                        <div id="notif-list" style="max-height: 350px; overflow-y: auto;">
                        <li><span class="dropdown-item text-muted text-center py-3">Đang tải dữ liệu...</span></li>
                </div>
                </ul>
            </div>
        </div>
    </div>

    <div class="p-4">
        @RenderBody()
    </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            function loadNotifications() {
                $.get('/Dashboard/GetUnreadNotifications', function (data) {
                    var listHtml = '';
                    if (data && data.length > 0) {
                        $('#notif-count').text(data.length).show();
                        $.each(data, function (i, item) {
                            var icon = item.type === 'Checkout' ? 'fa-broom text-warning' : 'fa-info-circle text-info';
                            listHtml += `
                                <li class="notification-item unread" data-id="${item.id}">
                                    <div class="d-flex justify-content-between">
                                        <span class="fw-bold small text-dark"><i class="fas ${icon} me-1"></i> ${item.title}</span>
                                        <small class="text-muted" style="font-size: 0.65rem;">${item.time}</small>
                                    </div>
                                    <div class="text-muted small mt-1 text-wrap">${item.message}</div>
                                </li>`;
                        });
                    } else {
                        $('#notif-count').hide();
                        listHtml = '<li class="p-4 text-center text-muted small">Không có thông báo mới</li>';
                    }
                    $('#notif-list').html(listHtml);
                });
            }

            // Gọi API ngay khi mở trang
            loadNotifications();

            // Đánh dấu đã đọc khi click
            $(document).on('click', '.notification-item.unread', function (e) {
                e.preventDefault();
                e.stopPropagation(); // Giữ menu không bị đóng
                var id = $(this).data('id');
                var $thisItem = $(this);

                $.post('/Dashboard/MarkAsRead', { id: id }, function () {
                    $thisItem.removeClass('unread').css('opacity', '0.6');
                    var currentCount = parseInt($('#notif-count').text()) - 1;
                    if (currentCount > 0) {
                        $('#notif-count').text(currentCount);
                    } else {
                        $('#notif-count').hide();
                    }
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>