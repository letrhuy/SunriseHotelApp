<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sunrise Luxury Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Roboto', sans-serif;
        }

        h1, h2, h3, h4, h5, h6, .navbar-brand {
            font-family: 'Playfair Display', serif;
        }

        /* Menu trong suốt đè lên ảnh */
        .navbar-custom {
            background-color: rgba(0, 0, 0, 0.8);
            padding: 15px 0;
        }

        .nav-link {
            color: white !important;
            font-weight: 500;
            text-transform: uppercase;
            margin-left: 20px;
            letter-spacing: 1px;
            transition: color 0.3s;
        }

            .nav-link:hover {
                color: #ffc107 !important;
            }

        /* Footer */
        footer {
            background-color: #1a1a1a;
            color: #aaa;
            padding: 50px 0;
        }

            footer h5 {
                color: white;
                margin-bottom: 20px;
            }

            footer a {
                color: #aaa;
                text-decoration: none;
            }

                footer a:hover {
                    color: white;
                }
    </style>
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom fixed-top">
            <div class="container">
                <a class="navbar-brand fs-3 fw-bold text-warning" href="/">
                    <i class="fas fa-crown me-2"></i> SUNRISE LUXURY
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item"><a class="nav-link" href="/">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" href="#room-list">Phòng nghỉ</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Dịch vụ</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Liên hệ</a></li>
                        <li class="nav-item ms-3">
                            <a class="btn btn-warning fw-bold text-dark rounded-pill px-4" href="/Account/Login">
                                <i class="fas fa-user-circle me-2"></i> Đăng nhập
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div style="padding-top: 0;">
        @RenderBody()
    </div>

    <footer class="mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5>SUNRISE LUXURY HOTEL</h5>
                    <p>Điểm đến lý tưởng cho kỳ nghỉ dưỡng đẳng cấp 5 sao. Tận hưởng không gian sang trọng và dịch vụ hoàn hảo.</p>
                </div>
                <div class="col-md-4">
                    <h5>LIÊN HỆ</h5>
                    <p><i class="fas fa-map-marker-alt me-2"></i> 123 Đường Biển, TP. Đà Nẵng</p>
                    <p><i class="fas fa-phone me-2"></i> 0909 123 456</p>
                    <p><i class="fas fa-envelope me-2"></i> booking@sunrisehotel.com</p>
                </div>
                <div class="col-md-4">
                    <h5>KẾT NỐI</h5>
                    <div class="fs-4">
                        <a href="#" class="me-3"><i class="fab fa-facebook"></i></a>
                        <a href="#" class="me-3"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="me-3"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
            </div>
            <hr class="my-4 border-secondary" />
            <div class="text-center small">
                &copy; 2024 Sunrise Hotel Management System. Designed by <strong>Le Truong Huy</strong>.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>