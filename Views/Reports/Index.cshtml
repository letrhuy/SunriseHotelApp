@model IEnumerable<SunriseHotelApp.Models.Booking>
@{
    ViewData["Title"] = "Báo cáo Doanh thu";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid p-4">
    <h4 class="fw-bold mb-4">DOANH THU HỆ THỐNG</h4>
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Ngày thanh toán</th>
                        <th class="text-end">Thực thu</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>#BK-@b.BookingId</td>
                            <td>@b.Customer?.FullName</td>
                            <td>@b.CheckOutDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end fw-bold text-success">
                                @(((decimal)b.FinalAmount).ToString("N0")) ₫
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>