@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Đăng nhập | Sunrise Hotel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-box {
            background: white;
            padding: 40px;
            border-radius: 10px;
            width: 400px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }
    </style>
</head>
<body>
    <div class="login-box text-center">
        <h3 class="fw-bold mb-4 text-primary">SUNRISE ADMIN</h3>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger p-2">@ViewBag.Error</div>
        }

        <form method="post">
            <div class="mb-3 text-start">
                <label class="fw-bold">Tài khoản</label>
                <input type="text" name="username" class="form-control" placeholder="manager" required>
            </div>
            <div class="mb-3 text-start">
                <label class="fw-bold">Mật khẩu</label>
                <input type="password" name="password" class="form-control" placeholder="123" required>
            </div>
            <button type="submit" class="btn btn-primary w-100 fw-bold">ĐĂNG NHẬP</button>
        </form>
    </div>
</body>
</html>