@model IEnumerable<SunriseHotelApp.Models.SystemUser>
@{
    ViewData["Title"] = "Quản lý nhân sự";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-uppercase text-dark"><i class="fas fa-users-cog me-2"></i> Đội ngũ nhân sự</h4>
        <a href="/Users/Create" class="btn btn-primary shadow-sm fw-bold"><i class="fas fa-user-plus me-1"></i> Thêm nhân viên</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small">
                    <tr>
                        <th class="ps-4 py-3">HỌ TÊN</th>
                        <th>TÊN ĐĂNG NHẬP</th>
                        <th>CHỨC VỤ</th>
                        <th class="text-center">TRẠNG THÁI</th>
                        <th class="text-end pe-4">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px; font-weight:bold;">
                                        @item.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="fw-bold text-dark">@item.FullName</span>
                                </div>
                            </td>
                            <td class="text-muted">@item.Username</td>
                            <td>
                                @if (item.UserRole == "Admin" || item.UserRole == "Manager")
                                {
                                    <span class="badge bg-danger bg-opacity-75">QUẢN LÝ</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark bg-opacity-50">LỄ TÂN</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-25 text-success rounded-pill px-3">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-3">Đã khóa</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a href="/Users/Edit/@item.UserId" class="btn btn-sm btn-light text-primary me-1" title="Chỉnh sửa">
                                    <i class="fas fa-pen"></i>
                                </a>

                                <a href="/Users/ToggleStatus/@item.UserId" class="btn btn-sm @(item.IsActive ? "btn-light text-danger" : "btn-light text-success")" title="@(item.IsActive ? "Khóa tài khoản" : "Mở khóa")">
                                    <i class="fas @(item.IsActive ? "fa-lock" : "fa-unlock")"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>