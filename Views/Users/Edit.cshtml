@model SunriseHotelApp.Models.SystemUser
@{
    ViewData["Title"] = "Cập nhật nhân viên";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid p-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold m-0"><i class="fas fa-user-edit me-2"></i> Cập nhật hồ sơ</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="Username" /> <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">HỌ VÀ TÊN</label>
                            <input asp-for="FullName" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">TÊN ĐĂNG NHẬP</label>
                            <input value="@Model.Username" class="form-control bg-light" readonly />
                            <small class="text-muted fst-italic">Không thể thay đổi tên đăng nhập</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">MẬT KHẨU MỚI</label>
                            <input asp-for="PasswordHash" type="password" class="form-control" placeholder="Để trống nếu không muốn đổi mật khẩu" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small">CHỨC VỤ</label>
                            <select asp-for="UserRole" class="form-select">
                                <option value="Staff">Nhân viên Lễ tân</option>
                                <option value="Admin">Quản lý (Manager)</option>
                            </select>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                            <label class="form-check-label" asp-for="IsActive">Đang hoạt động</label>
                        </div>

                        <div class="d-flex justify-content-between pt-2 border-top">
                            <a href="/Users" class="btn btn-light text-muted">Quay lại</a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold">
                                <i class="fas fa-save me-1"></i> Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>