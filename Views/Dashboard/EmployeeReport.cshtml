@model IEnumerable<SunriseHotelApp.Models.SystemUser>

@{
    ViewData["Title"] = "Báo cáo nhân sự";
    /* ĐÃ SỬA LỖI 1: Gọi đúng giao diện của Admin để không bị chìm đầu trang */
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-uppercase text-secondary mb-1"><i class="fas fa-users-cog me-2"></i>Báo cáo & Thống kê nhân sự</h4>
            <p class="text-muted mb-0">Quản lý danh sách nhân viên và quyền truy cập hệ thống</p>
        </div>
    </div>

    <div class="card mb-4 shadow-sm border-0 rounded-3">
        <div class="card-body bg-light rounded-3">
            <form method="get" asp-action="EmployeeReport" asp-controller="Dashboard" class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold text-secondary">Lọc theo Chức vụ:</label>
                    <select name="roleFilter" class="form-select border-secondary">
                        <option value="">-- Tất cả chức vụ --</option>
                        <option value="Admin" selected="@(ViewBag.CurrentRoleFilter == "Admin" ? "selected" : null)">Quản trị viên (Admin)</option>
                        <option value="Staff" selected="@(ViewBag.CurrentRoleFilter == "Staff" ? "selected" : null)">Nhân viên (Staff)</option>
                        <option value="Accountant" selected="@(ViewBag.CurrentRoleFilter == "Accountant" ? "selected" : null)">Kế toán (Accountant)</option>
                        <option value="Housekeeper" selected="@(ViewBag.CurrentRoleFilter == "Housekeeper" ? "selected" : null)">Buồng phòng (Housekeeper)</option>
                        <option value="Chef" selected="@(ViewBag.CurrentRoleFilter == "Chef" ? "selected" : null)">Bếp (Chef)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-bold"><i class="fas fa-search me-1"></i> Lọc dữ liệu</button>
                </div>
                <div class="col-md-2">
                    <a asp-action="EmployeeReport" class="btn btn-outline-secondary w-100 fw-bold"><i class="fas fa-sync me-1"></i> Bỏ lọc</a>
                </div>
            </form>
        </div>
    </div>

    <div class="alert alert-info border-info shadow-sm">
        <i class="fas fa-info-circle me-2"></i><strong>Tổng số nhân sự tìm thấy:</strong> <span class="badge bg-info text-dark fs-6 ms-1">@ViewBag.TotalEmployees</span> người
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center" style="width: 5%;">STT</th>
                            <th style="width: 15%;">Tên đăng nhập</th>
                            <th style="width: 25%;">Họ và tên</th>
                            <th style="width: 15%;">Chức vụ</th>
                            <th style="width: 20%;">Số điện thoại</th>
                            <th class="text-center" style="width: 20%;">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int stt = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-muted">@(stt++)</td>
                                    <td><span class="text-primary fw-semibold">@item.Username</span></td>
                                    <td class="fw-bold">@item.FullName</td>
                                    <td>
                                        @if (item.UserRole == "Admin")
                                        {
                                            <span class="badge bg-danger px-3 py-2">Admin</span>
                                        }
                                        else if (item.UserRole == "Staff")
                                        {

                                            <span class="badge bg-primary px-3 py-2">Staff</span>
                                        }
                                        else if (item.UserRole == "Accountant")
                                        {

                                            <span class="badge bg-warning text-dark px-3 py-2">Kế toán</span>
                                        }
                                        else if (item.UserRole == "Housekeeper")
                                        {

                                            <span class="badge bg-success px-3 py-2">Buồng phòng</span>
                                        }
                                        else if (item.UserRole == "Chef")
                                        {

                                            <span class="badge bg-secondary px-3 py-2">Bếp</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-dark px-3 py-2">@item.UserRole</span>
                                        }
                                    </td>
                                    <td>
                                        <i class="fas fa-phone-alt text-muted me-2" style="font-size: 0.8rem;"></i>
                                        @(string.IsNullOrEmpty(item.PhoneNumber) ? "Chưa cập nhật" : item.PhoneNumber)
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Đang làm</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger fw-bold"><i class="fas fa-times-circle me-1"></i> Đã nghỉ</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-search fa-3x mb-3 text-light"></i><br />
                                    Không tìm thấy nhân viên nào phù hợp với bộ lọc.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>