@model IEnumerable<SunriseHotelApp.Models.Booking>
@{
    ViewData["Title"] = "Quản lý Đặt phòng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid p-4">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold text-primary">DANH SÁCH ĐƠN ĐẶT PHÒNG</h5>
        </div>
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="bg-light">
                    <tr>
                        <th>Khách hàng</th>
                        <th>Phòng</th>
                        <th>Ngày đến</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Customer?.FullName</strong><br><small>@item.Customer?.PhoneNumber</small></td>
                            <td><span class="badge bg-dark">@item.Room?.RoomNumber</span></td>
                            <td>@item.CheckInDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge @(item.BookingStatus == "Completed" ? "bg-success" : "bg-warning")">
                                    @item.BookingStatus
                                </span>
                            </td>
                            <td class="text-end fw-bold">@(((decimal)item.TotalAmount).ToString("N0")) ₫</td>
                            <td class="text-center">
                                <a href="/Bookings/Checkout?roomId=@item.RoomId" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>