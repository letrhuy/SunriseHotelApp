@model SunriseHotelApp.Models.Booking
@{
    ViewData["Title"] = "Gọi dịch vụ phòng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var products = ViewBag.Products as List<SunriseHotelApp.Models.Product>;
}

<div class="container-fluid pt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-utensils me-2"></i>Gọi Dịch Vụ / Món Ăn
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <strong>Phòng: @Model.Room?.RoomNumber</strong> - Khách: @Model.Customer?.FullName
                    </div>

                    <form asp-action="AddService" method="post">
                        <input type="hidden" name="bookingId" value="@Model.BookingId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Chọn món ăn / Dịch vụ:</label>
                            <select name="productId" class="form-select form-select-lg" required>
                                <option value="">-- Vui lòng chọn món --</option>
                                @if (products != null)
                                {
                                    foreach (var item in products)
                                    {
                                        <option value="@item.ProductId">
                                            @item.ProductName - Giá: @item.UnitPrice.ToString("N0")₫ (Còn: @item.CurrentStock)
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Số lượng:</label>
                            <input type="number" name="quantity" class="form-control" value="1" min="1" required />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/Rooms/Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại sơ đồ
                            </a>
                            <button type="submit" class="btn btn-success fw-bold px-4">
                                <i class="fas fa-plus-circle me-1"></i> THÊM VÀO PHÒNG
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>