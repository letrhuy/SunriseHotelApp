@model IEnumerable<SunriseHotelApp.Models.RoomType>
@{
    ViewData["Title"] = "Kết quả tìm kiếm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var checkIn = ViewBag.CheckIn;
    var checkOut = ViewBag.CheckOut;
}

<style>
    .room-card {
        transition: all 0.3s ease;
        border: none;
    }

        .room-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.15) !important;
        }

    h1, h2, h3, h4, h5, .font-serif {
        font-family: 'Playfair Display', serif;
    }
</style>

<div class="position-relative py-5 bg-dark text-white text-center shadow-sm"
     style="margin-top: 85px; background-image: url('https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?q=80&w=1920'); background-size: cover; background-position: center;">

    <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-75"></div>

    <div class="container position-relative z-2">
        <h2 class="font-serif fw-bold display-5">Kết Quả Tìm Kiếm</h2>
        <p class="lead mb-0 opacity-75">
            Ngày: <span class="text-warning fw-bold">@Convert.ToDateTime(checkIn).ToString("dd/MM/yyyy")</span>
            - <span class="text-warning fw-bold">@Convert.ToDateTime(checkOut).ToString("dd/MM/yyyy")</span>
        </p>
    </div>
</div>

<div class="container py-5">

    <div class="d-flex align-items-center mb-4">
        <span class="bg-warning me-3 rounded" style="width: 5px; height: 35px;"></span>
        <div>
            <h3 class="fw-bold font-serif mb-0 text-dark">Danh Sách Phòng Phù Hợp</h3>
            <small class="text-muted">Vui lòng chọn hạng phòng mong muốn</small>
        </div>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                var imgSrc = string.IsNullOrEmpty(item.Image) ? "https://placehold.co/600x400" : item.Image;

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm room-card">
                        <div class="position-relative" style="height: 240px; overflow: hidden; border-top-left-radius: 0.375rem; border-top-right-radius: 0.375rem;">
                            <img src="@imgSrc" class="w-100 h-100" style="object-fit: cover;" alt="@item.RoomTypeName">
                            <span class="position-absolute top-0 end-0 m-3 badge bg-success shadow">Còn trống</span>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h4 class="card-title font-serif fw-bold mb-1">@item.RoomTypeName</h4>

                            <div class="text-muted small mb-3">
                                <i class="fas fa-user-friends me-1"></i> @item.MaxGuests khách |
                                <i class="fas fa-ruler-combined me-1"></i> 30m²
                            </div>

                            <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @(string.IsNullOrEmpty(item.Description) ? "Không gian sang trọng, đầy đủ tiện nghi với view nhìn ra thành phố tuyệt đẹp." : item.Description)
                            </p>

                            <hr class="opacity-10 my-3">

                            <div class="d-flex justify-content-between align-items-end">
                                <div>
                                    <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Giá mỗi đêm</small>
                                    <h5 class="text-danger fw-bold mb-0">@(((decimal)item.PricePerNight).ToString("N0")) ₫</h5>
                                </div>
                                <a href="/Bookings/Create?roomTypeId=@item.RoomTypeID&checkIn=@checkIn&checkOut=@checkOut"
                                   class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm">
                                    CHỌN <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-warning text-center p-5 rounded-3 shadow-sm">
                    <i class="fas fa-calendar-times fa-3x mb-3 text-warning"></i>
                    <h4>Hết phòng trống</h4>
                    <p class="mb-0">Rất tiếc, không còn phòng nào trống trong khoảng thời gian này.</p>
                    <a href="/" class="btn btn-outline-dark mt-3">Quay lại trang chủ</a>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-5 pt-4">
        <a href="/" class="text-decoration-none text-muted fw-bold small">
            <i class="fas fa-arrow-left me-2"></i> QUAY LẠI TRANG CHỦ
        </a>
    </div>

</div>