@model IEnumerable<SunriseHotelApp.Models.Product>
@{
    ViewData["Title"] = "Quản lý Tồn kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid p-4">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-bold text-primary">QUẢN LÝ KHO HÀNG</h5>
            <a href="/Imports/Create" class="btn btn-primary btn-sm">Nhập hàng mới</a>
        </div>
        <div class="card-body">
            <table class="table table-hover">
                <thead class="bg-light">
                    <tr>
                        <th>Tên sản phẩm</th>
                        <th>Đơn vị</th>
                        <th>Đơn giá</th>
                        <th class="text-center">Tồn kho</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-bold">@p.ProductName</td>
                            <td>@p.Unit</td>
                            <td>@p.UnitPrice.ToString("N0") ₫</td>
                            <td class="text-center">
                                <span class="fw-bold @(p.CurrentStock < p.MinStockLevel ? "text-danger" : "")">
                                    @p.CurrentStock
                                </span>
                            </td>
                            <td>
                                @if (p.CurrentStock < p.MinStockLevel)
                                {
                                    <span class="badge bg-danger">Sắp hết hàng</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Ổn định</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>